# Copy to .env and fill in. .env is gitignored.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# Which backend the client and evals talk to: "local" or "cloudrun".
TAKI_BACKEND=local

# The CLOUD RUN service URL, with /v1 appended. Required for the cloudrun
# backend only. `make deploy` prints the value to paste here. The local
# backend deliberately ignores this, so filling it in cannot redirect
# `make local` at the billable GPU service.
#   TAKI_BASE_URL=https://taki-xxxxxxxx-uc.a.run.app/v1
TAKI_BASE_URL=

# Optional. Overrides the local Ollama URL from config/models.yaml. Only needed
# if Ollama is not on its default port.
#   OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=

# ---------------------------------------------------------------------------
# Google Cloud - used by serving/deploy.sh and serving/smoke_test.sh
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=steadfast-helix-429321-b2

# Must be a region with Cloud Run GPU support. See MODELS.md for the
# verified list. us-central1 supports both L4 and RTX PRO 6000.
GCP_REGION=us-central1

# Cloud Run service name. Re-running deploy.sh with the same name updates
# the existing service rather than creating a second one.
CLOUD_RUN_SERVICE=taki

# Artifact Registry repo that holds the serving image.
AR_REPO=taki

# ---------------------------------------------------------------------------
# GPU shape - THESE FLAGS COST MONEY. See README "GPU charges".
# ---------------------------------------------------------------------------
# nvidia-l4 (4 CPU / 16Gi min) or nvidia-rtx-pro-6000 (20 CPU / 80Gi min).
GPU_TYPE=nvidia-l4
CPU=8
MEMORY=32Gi

# Hard ceiling on concurrently billed GPU instances. Keep at 1 unless you
# have raised quota and intend to pay for more.
MAX_INSTANCES=1
CONCURRENCY=4

# ---------------------------------------------------------------------------
# Not required for the default path
# ---------------------------------------------------------------------------
# Only needed if you switch to pulling weights from Hugging Face instead of
# the Ollama library. The Ollama path needs NO token. See MODELS.md.
HF_TOKEN=

# ---------------------------------------------------------------------------
# taki_mcp — MCP server (CPU only, private)
# ---------------------------------------------------------------------------
MCP_SERVICE=taki-mcp
# Cloud SQL instance for the conversation store, as PROJECT:REGION:INSTANCE.
# Leave empty to run without the store.
DB_INSTANCE=
# Secret Manager secret holding the Postgres DSN. You create it; the scripts
# never see the password. See taki_mcp/deploy.sh for the exact command.
DB_DSN_SECRET=taki-agent-dsn
# URL that `make mcp-deploy` prints.
TAKI_MCP_URL=

# ---------------------------------------------------------------------------
# taki_web — farmer chat UI (CPU only, private; open via `make web-open`)
# ---------------------------------------------------------------------------
WEB_SERVICE=taki-web
# URL that `make web-deploy` prints.
TAKI_WEB_URL=

# Intended access for the smoke negative-test. 1 = service is meant to be public
# (negative test asserts it is REACHABLE without auth); 0/unset = private
# (negative test asserts 403). Making a GPU-backed service public removes the
# lock that keeps an open endpoint from becoming an open bill — set deliberately.
TAKI_MODEL_PUBLIC=0
TAKI_WEB_PUBLIC=0
