# TAKI serving image.
#
# The model weights are BAKED IN rather than pulled at container start. This
# diverges deliberately from Google's Ollama-on-Cloud-Run tutorial, which runs
# the stock image and pulls the model on boot behind a 240-second startup
# probe. Pulling on boot means every scale-from-zero re-downloads the weights.
#
# Google's GPU best-practices page says image storage is "best suited for
# smaller models less than 10 GB" and that such models benefit from Cloud Run's
# optimized container streaming. gemma3:4b is 3.3GB, so baking wins.
# See MODELS.md section 3.

FROM ollama/ollama:latest

# Model IDs arrive in build.env, generated by deploy.sh from
# config/models.yaml. There is no model literal in this file.
#
# They are NOT Docker ARGs: `gcloud builds submit --tag` builds without
# --build-arg, so ARG values would silently be empty and the build would fail
# at `ollama pull ""`. A copied env file works with any build front end.

# Cloud Run always sends traffic to $PORT (8080 by default) and Ollama must
# listen on all interfaces, not loopback.
ENV OLLAMA_HOST=0.0.0.0:8080

# Keep the model store on a normal image layer. The upstream image may declare
# a volume on /root/.ollama, and writes to a volume during build are discarded.
ENV OLLAMA_MODELS=/models

# Never unload the model between requests. The GPU is already paid for while
# the instance is up; reloading weights would add latency for nothing.
ENV OLLAMA_KEEP_ALIVE=-1

# Rendered by deploy.sh from taki_model/Modelfile + the Hausa system prompt,
# using the same renderer the local build uses.
COPY Modelfile.rendered /build/Modelfile

# BASE_MODEL and TAKI_MODEL, straight from config/models.yaml.
COPY build.env /build/build.env

# Start a temporary server, pull the base weights, bake the TAKI model, stop.
# `ollama create` needs a live server, so this has to be one RUN layer.
RUN set -eux; \
    . /build/build.env; \
    ollama serve & \
    for i in $(seq 1 120); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
    ollama list >/dev/null; \
    ollama pull "$BASE_MODEL"; \
    ollama create "$TAKI_MODEL" -f /build/Modelfile; \
    ollama list; \
    pkill -f "ollama serve" || true; \
    sleep 2

EXPOSE 8080

# Reset the upstream ENTRYPOINT explicitly so CMD is unambiguous.
ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
